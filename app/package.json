{
  "name": "tensor-trail",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:agent",
    "build:agent": "vite build --config vite.agent.config.ts",
    "agent": "node scripts/agent.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:cli": "npm run build:agent && node scripts/test-cli.mjs",
    "format": "prettier --write src tests scripts examples vite*.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
